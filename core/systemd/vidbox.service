[Unit]
Description=Hata: VidBox — домашній відеосервер
After=gazda.service network-online.target local-fs.target
Wants=network-online.target

[Service]
User=hata
Group=hata
SupplementaryGroups=video render
Environment=VIDBOX_MANAGED=hata
ExecStart=/usr/bin/python3 /opt/hata/src/apps/vidbox/vidbox.py --data /var/lib/hata/vidbox --no-browser
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/hata
PrivateTmp=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
