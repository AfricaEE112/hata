[Unit]
Description=Hata: статус і QR-код на екрані ноутбука (tty1)
After=gazda.service systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
ExecStart=/usr/bin/python3 /opt/hata/src/hata/screen.py
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
